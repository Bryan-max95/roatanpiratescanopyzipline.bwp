# Configurar en Vercel > Settings > Environment Variables.
# Para desarrollo, copiar a .env.local y sustituir los ejemplos.
# Nunca subir .env.local a GitHub.

# PostgreSQL / Neon: reservas, reseñas y administración.
# En Vercel, usar la URL de conexión con pool proporcionada por Neon.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full"

# Vercel Blob PUBLIC: fotos y videos nuevos en producción.
BLOB_READ_WRITE_TOKEN=""

# Solo para inicializar una base nueva mediante pnpm db:migrate.
# No hacen falta en Vercel si el administrador ya existe en la base.
ADMIN_ROOT_USERNAME="change-me"
ADMIN_ROOT_PASSWORD="change-me-with-a-long-password"

# URL pública final, con https:// y sin barra al final.
NEXT_PUBLIC_SITE_URL="https://www.roatanpiratescanopy.com"

# Opcional: token de Google Search Console.
GOOGLE_SITE_VERIFICATION=""
